# Copia este archivo a .env y rellena tus claves.

# Google Gemini — generación de preguntas (gratis en Google AI Studio, ~20 req/día)
GEMINI_API_KEY=

# OpenCode Go — fallback cuando Gemini se agota
OPENCODE_API_KEY=

# Opcional: clave distinta para el TTS, si quieres separar su cuota de la de generación
TTS_GEMINI_API_KEY=

# Opcional: voz única de Gemini TTS. Default: Kore
TTS_VOICE=

# Opcional: lista de voces separadas por coma para alternar por pregunta.
# Si está definida, tiene prioridad sobre TTS_VOICE.
TTS_VOICES=Kore,Charon,Puck
